#!/command/with-contenv bash
# shellcheck shell=bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/tplink-network.sh

fail() {
    echo "Configuration error: $*" >&2
    exit 1
}

valid_ipv4() {
    local value="$1"
    local part
    local -a parts=()

    [[ "$value" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    IFS='.' read -r -a parts <<<"$value"

    for part in "${parts[@]}"; do
        (( 10#$part <= 255 )) || return 1
    done
}

network_of() {
    ipcalc -n "$1" 2>/dev/null |
        awk -F= '$1 == "NETWORK" { print $2; exit }'
}

valid_network_cidr() {
    local value="$1"
    local address prefix network

    [[ "$value" =~ ^([^/]+)/([0-9]{1,2})$ ]] || return 1
    address="${BASH_REMATCH[1]}"
    prefix="${BASH_REMATCH[2]}"
    valid_ipv4 "$address" || return 1
    (( 10#$prefix <= 32 )) || return 1
    network="$(network_of "$value")"
    [[ -n "$network" && "$value" == "$network/$((10#$prefix))" ]]
}

valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] \
        && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

for name in \
    LAN_IF \
    LAN_NET \
    DOCKER_SUBNET \
    HA_IP \
    HA_PORT \
    RELAY_DEBUG \
    FIREWALL_CHECK_INTERVAL \
    RELAY_NETWORK_CHECK_INTERVAL; do
    [[ -n "${!name:-}" ]] || fail "$name is required"
done

[[ "$LAN_IF" =~ ^[[:alnum:]_.:@-]{1,15}$ ]] \
    || fail "LAN_IF is invalid: $LAN_IF"
valid_network_cidr "$LAN_NET" \
    || fail "LAN_NET must be a network in CIDR notation: $LAN_NET"
valid_network_cidr "$DOCKER_SUBNET" \
    || fail "DOCKER_SUBNET must be a network in CIDR notation: $DOCKER_SUBNET"
valid_ipv4 "$HA_IP" || fail "HA_IP must be an IPv4 address: $HA_IP"
valid_port "$HA_PORT" || fail "HA_PORT must be from 1 to 65535: $HA_PORT"

docker_prefix="${DOCKER_SUBNET#*/}"
docker_network="${DOCKER_SUBNET%/*}"
ha_network="$(network_of "$HA_IP/$docker_prefix")"
[[ "$ha_network" == "$docker_network" ]] \
    || fail "HA_IP $HA_IP is outside DOCKER_SUBNET $DOCKER_SUBNET"

for interval_name in FIREWALL_CHECK_INTERVAL RELAY_NETWORK_CHECK_INTERVAL; do
    interval="${!interval_name}"
    if ! [[ "$interval" =~ ^[0-9]+$ ]] \
        || ! (( 10#$interval >= 1 && 10#$interval <= 3600 )); then
        fail "$interval_name must be from 1 to 3600 seconds"
    fi
done

case "${RELAY_DEBUG,,}" in
    false|true) ;;
    *) fail "RELAY_DEBUG must be true or false" ;;
esac

mapfile -t docker_routes < <(route_interfaces_for_subnet "$DOCKER_SUBNET")
case "${#docker_routes[@]}" in
    0)
        echo "Configuration: The Docker route is not ready. Services will wait."
        ;;
    1)
        bridge_if="${docker_routes[0]}"
        [[ "$bridge_if" != "lo" && "$bridge_if" != "$LAN_IF" ]] \
            || fail "DOCKER_SUBNET uses invalid relay interface $bridge_if"
        ha_route_if="$(route_interface_for_ip "$HA_IP")"
        [[ "$ha_route_if" == "$bridge_if" ]] \
            || fail "HA_IP uses ${ha_route_if:-no interface}, not $bridge_if"
        ;;
    *)
        fail "DOCKER_SUBNET has more than one route: ${docker_routes[*]}"
        ;;
esac

if ! ip link show "$LAN_IF" >/dev/null 2>&1; then
    echo "Configuration: LAN interface $LAN_IF is not ready. Services will wait."
else
    lan_ip="$(interface_ipv4 "$LAN_IF")"
    if [[ -z "$lan_ip" ]]; then
        echo "Configuration: LAN interface $LAN_IF has no IPv4 address. Services will wait."
    else
        lan_prefix="${LAN_NET#*/}"
        lan_network="$(network_of "$lan_ip/$lan_prefix")/$lan_prefix"
        [[ "$lan_network" == "$LAN_NET" ]] \
            || fail "LAN interface $LAN_IF is outside LAN_NET $LAN_NET"
    fi
fi

if ! iptables -S DOCKER-USER >/dev/null 2>&1 \
    && ! iptables-legacy -S DOCKER-USER >/dev/null 2>&1; then
    echo "Configuration: DOCKER-USER is not ready. The firewall service will wait."
fi

echo "Configuration is valid: LAN=$LAN_NET; Docker=$DOCKER_SUBNET; Home Assistant=http://$HA_IP:$HA_PORT/"
