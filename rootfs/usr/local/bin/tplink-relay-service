#!/command/with-contenv bash
# shellcheck shell=bash
set -Eeuo pipefail

if [[ "$#" -ne 2 ]]; then
    echo "Usage: $0 RELAY_ID PORT" >&2
    exit 64
fi

relay_id="$1"
port="$2"
: "${LAN_IF:?LAN_IF is required}"
: "${DOCKER_SUBNET:?DOCKER_SUBNET is required}"
: "${HA_IP:?HA_IP is required}"
lan_if="$LAN_IF"
docker_subnet="$DOCKER_SUBNET"
ha_ip="$HA_IP"
configured_ports="${RELAY_PORTS:-9999,20002,20004}"
check_interval="${RELAY_TOPOLOGY_CHECK_INTERVAL:-5}"
debug="${RELAY_DEBUG:-false}"

stop_requested=false
child_pid=""

log() {
    printf 'relay-%s: %s\n' "$port" "$*"
}

interface_ipv4() {
    ip -4 -o address show dev "$1" scope global 2>/dev/null |
        awk 'NR == 1 { split($4, address, "/"); print address[1] }'
}

route_device_for_ip() {
    ip -4 route get "$1" 2>/dev/null |
        awk '{
            for (i = 1; i <= NF; i++) {
                if ($i == "dev") {
                    print $(i + 1)
                    exit
                }
            }
        }'
}

bridge_for_subnet() {
    local -a route_devices=()

    mapfile -t route_devices < <(
        ip -4 route show exact "$docker_subnet" 2>/dev/null |
            awk '{
                for (i = 1; i <= NF; i++) {
                    if ($i == "dev") {
                        print $(i + 1)
                        break
                    }
                }
            }'
    )

    (( ${#route_devices[@]} == 1 )) || return 1
    [[ "${route_devices[0]}" != "lo" && "${route_devices[0]}" != "$lan_if" ]] \
        || return 1
    printf '%s\n' "${route_devices[0]}"
}

usable_topology() {
    local bridge_if ha_route_if

    [[ -n "$(interface_ipv4 "$lan_if")" ]] || return 1
    bridge_if="$(bridge_for_subnet)" || return 1
    [[ -n "$(interface_ipv4 "$bridge_if")" ]] || return 1
    ha_route_if="$(route_device_for_ip "$ha_ip")"
    [[ "$ha_route_if" == "$bridge_if" ]] || return 1
    printf '%s\n' "$bridge_if"
}

stop_child() {
    local _attempt

    [[ -n "$child_pid" ]] || return 0
    kill -TERM "$child_pid" 2>/dev/null || true

    for _attempt in {1..50}; do
        : "$_attempt"
        kill -0 "$child_pid" 2>/dev/null || break
        sleep 0.1
    done

    if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null || true
    fi

    wait "$child_pid" 2>/dev/null || true
    child_pid=""
}

handle_stop() {
    stop_requested=true
    [[ -z "$child_pid" ]] || kill -TERM "$child_pid" 2>/dev/null || true
}

trap handle_stop TERM INT

if ! [[ "$relay_id" =~ ^[0-9]+$ ]] \
    || ! (( 10#$relay_id >= 1 && 10#$relay_id <= 99 )); then
    log "invalid relay ID $relay_id" >&2
    exit 64
fi
if ! [[ "$port" =~ ^[0-9]+$ ]] \
    || ! (( 10#$port >= 1 && 10#$port <= 65535 )); then
    log "invalid UDP port $port" >&2
    exit 64
fi

case ",$configured_ports," in
    *",$port,"*) ;;
    *) log "port is absent from RELAY_PORTS=$configured_ports" >&2; exit 64 ;;
esac

args=(--id "$relay_id" --port "$port")
case "${debug,,}" in
    1|true|yes|on) args+=(-d) ;;
esac

last_wait_message=0
while [[ "$stop_requested" == false ]]; do
    bridge_if="$(usable_topology || true)"
    if [[ -z "$bridge_if" ]]; then
        now="$(date +%s)"
        if (( now - last_wait_message >= 30 )); then
            log "waiting for IPv4 on $lan_if and the exact $docker_subnet route"
            last_wait_message="$now"
        fi
        sleep 2 &
        wait "$!" || true
        continue
    fi

    relay_args=("${args[@]}" --dev "$lan_if" --dev "$bridge_if")
    log "starting $lan_if <-> $bridge_if"
    /usr/local/bin/udp-broadcast-relay-redux "${relay_args[@]}" &
    child_pid="$!"

    while [[ "$stop_requested" == false ]]; do
        process_state=""
        if [[ -r "/proc/$child_pid/stat" ]]; then
            process_state="$(awk '{ print $3 }' "/proc/$child_pid/stat" 2>/dev/null || true)"
        fi

        if [[ -z "$process_state" || "$process_state" == Z ]]; then
            status=0
            wait "$child_pid" || status="$?"
            log "relay process exited with status $status; restarting"
            child_pid=""
            break
        fi

        sleep "$check_interval" &
        wait "$!" || true

        current_bridge="$(usable_topology || true)"
        if [[ "$current_bridge" != "$bridge_if" ]]; then
            log "topology changed or lost; stopping relay before retry"
            stop_child
            break
        fi
    done

    if [[ "$stop_requested" == true ]]; then
        stop_child
        break
    fi

    sleep 2 &
    wait "$!" || true
done

log "stopped"
