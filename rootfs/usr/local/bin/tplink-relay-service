#!/command/with-contenv bash
# shellcheck shell=bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/tplink-network.sh

if [[ "$#" -ne 2 ]]; then
    echo "Usage: $0 RELAY_ID PORT" >&2
    exit 64
fi

relay_id="$1"
port="$2"
: "${LAN_IF:?LAN_IF is required}"
: "${DOCKER_SUBNET:?DOCKER_SUBNET is required}"
: "${HA_IP:?HA_IP is required}"
: "${RELAY_NETWORK_CHECK_INTERVAL:?RELAY_NETWORK_CHECK_INTERVAL is required}"
: "${RELAY_DEBUG:?RELAY_DEBUG is required}"

stop_requested=false
child_pid=""

log() {
    printf 'relay-%s: %s\n' "$port" "$*"
}

active_bridge() {
    local bridge_if ha_route_if

    [[ -n "$(interface_ipv4 "$LAN_IF")" ]] || return 1
    bridge_if="$(bridge_for_subnet "$DOCKER_SUBNET" "$LAN_IF")" || return 1
    [[ -n "$(interface_ipv4 "$bridge_if")" ]] || return 1
    ha_route_if="$(route_interface_for_ip "$HA_IP")"
    [[ "$ha_route_if" == "$bridge_if" ]] || return 1
    printf '%s\n' "$bridge_if"
}

stop_child() {
    [[ -n "$child_pid" ]] || return 0
    kill -TERM "$child_pid" 2>/dev/null || true

    for _ in {1..50}; do
        kill -0 "$child_pid" 2>/dev/null || break
        sleep 0.1
    done

    if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null || true
    fi

    wait "$child_pid" 2>/dev/null || true
    child_pid=""
}

handle_stop() {
    stop_requested=true
    [[ -z "$child_pid" ]] || kill -TERM "$child_pid" 2>/dev/null || true
}

trap handle_stop TERM INT

args=(--id "$relay_id" --port "$port")
case "${RELAY_DEBUG,,}" in
    true) args+=(-d) ;;
esac

last_wait_message=0
while [[ "$stop_requested" == false ]]; do
    bridge_if="$(active_bridge || true)"
    if [[ -z "$bridge_if" ]]; then
        now="$(date +%s)"
        if (( now - last_wait_message >= 30 )); then
            log "waiting for IPv4 on $LAN_IF and a route for $DOCKER_SUBNET"
            last_wait_message="$now"
        fi
        sleep 2 &
        wait "$!" || true
        continue
    fi

    relay_args=("${args[@]}" --dev "$LAN_IF" --dev "$bridge_if")
    log "starting on $LAN_IF and $bridge_if"
    /usr/local/bin/udp-broadcast-relay-redux "${relay_args[@]}" &
    child_pid="$!"

    while [[ "$stop_requested" == false ]]; do
        process_state=""
        if [[ -r "/proc/$child_pid/stat" ]]; then
            process_state="$(awk '{ print $3 }' "/proc/$child_pid/stat" 2>/dev/null || true)"
        fi

        if [[ -z "$process_state" || "$process_state" == Z ]]; then
            status=0
            wait "$child_pid" || status="$?"
            log "process exited with status $status. Restarting."
            child_pid=""
            break
        fi

        sleep "$RELAY_NETWORK_CHECK_INTERVAL" &
        wait "$!" || true

        current_bridge="$(active_bridge || true)"
        if [[ "$current_bridge" != "$bridge_if" ]]; then
            log "network changed. Stopping the relay."
            stop_child
            break
        fi
    done

    if [[ "$stop_requested" == true ]]; then
        stop_child
        break
    fi

    sleep 2 &
    wait "$!" || true
done

log "stopped"
