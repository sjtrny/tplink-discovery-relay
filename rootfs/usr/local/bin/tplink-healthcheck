#!/command/with-contenv bash
# shellcheck shell=bash
set -Eeuo pipefail

status=0

for port in 9999 20002 20004; do
    mapfile -t relay_pids < <(
        pgrep -f "^/usr/local/bin/udp-broadcast-relay-redux .*--port ${port}([[:space:]]|$)" \
            || true
    )

    if (( ${#relay_pids[@]} != 1 )); then
        echo "health: UDP $port has ${#relay_pids[@]} relay processes; expected 1" >&2
        status=1
    fi
done

if ! /usr/local/bin/tplink-firewall check; then
    status=1
fi

exit "$status"
